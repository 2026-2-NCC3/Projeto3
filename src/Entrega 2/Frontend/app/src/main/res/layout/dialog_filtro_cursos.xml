<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_card_sobreposicao1"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="20dp">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="🔍 Filtros"
            android:textColor="@color/grayish_indigo"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnFecharFiltro"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/icon_round_close"
            app:tint="@color/grayish" />
    </RelativeLayout>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="> Selecione uma ou mais áreas:"
        android:textColor="@color/magenta"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <CheckBox
            android:id="@+id/cbTodosBackdrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="🌐 Todas as Áreas"
            android:textColor="@color/grayish_indigo"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/cbTechBackdrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💻 Tecnologia"
            android:textColor="@color/grayish_indigo"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/cbGestaoBackdrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 Negócios e Administração"
            android:textColor="@color/grayish_indigo"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/cbLogisticaBackdrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚚 Logística"
            android:textColor="@color/grayish_indigo"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/cbMarketingBackdrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📢 Marketing"
            android:textColor="@color/grayish_indigo"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#40FFFFFF" />


    <Button
        android:id="@+id/btnAplicarBackdropFilter"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:backgroundTint="@color/magenta"
        android:text="✓ Aplicar Seleção ao Catálogo"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>