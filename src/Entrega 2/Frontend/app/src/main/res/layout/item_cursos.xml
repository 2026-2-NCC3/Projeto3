<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="250dp"
    android:layout_height="350dp"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/grayish_red"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgCursos"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            app:srcCompat="@drawable/logo_proxima_etapa"
            android:scaleType="centerCrop"
            android:contentDescription="Img Curso" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtTituloCurso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome Curso"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/grayish_indigo" />

            <TextView
                android:id="@+id/txtDescricaoCurso1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="descrição1"
                android:textAppearance="?attr/textAppearanceBody2"
                android:textColor="@color/grayish" />

            <TextView
                android:id="@+id/txtDescricaoCurso2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="descrição2"
                android:textAppearance="?attr/textAppearanceBody2"
                android:textColor="@color/grayish" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInscrever"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:text="Inscreva-se"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/purple"/>

            <TextView
                android:id="@+id/txtStatusCurso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:text="Disponível"
                android:textColor="#10B981"
                android:textStyle="bold"
                android:textSize="14sp"/>
        </LinearLayout>


    </LinearLayout>

</com.google.android.material.card.MaterialCardView>