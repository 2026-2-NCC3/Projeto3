<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_card_sobreposicao2"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="20dp">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTituloListaPresencaProf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 Lista de Presença da Turma"
                android:textColor="@color/dark_indigo"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btnFecharCardDialog"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/icon_round_close"
            app:tint="@color/grayish" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/containerItensPresencaTurma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>