<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_card_sobreposicao1"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="15dp">

    <TextView
        android:id="@+id/txtNomeCursoPersonalizar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="20dp"
        android:text="Nome do Curso"
        android:textColor="@color/dark_indigo"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/btnRemoverCursoPersonalizar"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="20dp"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/icon_round_delete"
        app:tint="@color/grayish_indigo"
        android:contentDescription="Remover" />
</LinearLayout>