<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_sobreposicao2"
    android:elevation="6dp"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar Perfil"
            android:textColor="@color/dark_indigo"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Atualize suas informações pessoais e foto de perfil abaixo."
            android:textColor="@color/dark_gray"
            android:textSize="12sp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_avatar_circle"
                android:elevation="4dp">

                <ImageView
                    android:id="@+id/imgAvatarPreviewEditarDialog"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/round_person"
                    android:contentDescription="Preview Avatar" />
            </FrameLayout>

            <Button
                android:id="@+id/btnEnviarFotoGaleriaEditarDialog"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/transparent"
                android:paddingStart="14dp"
                android:paddingTop="0dp"
                android:paddingEnd="14dp"
                android:paddingBottom="0dp"
                android:text="📤 Enviar minha foto"
                android:textColor="@color/azure_apagado"
                android:textSize="11sp"
                android:textStyle="bold"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Ou escolha um avatar:"
                android:textColor="@color/purple"
                android:textSize="12sp"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:columnCount="3"
                android:rowCount="1">

                <ImageView
                    android:id="@+id/avatarOpt1Editar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/round_person"
                    android:contentDescription="Avatar 1" />

                <ImageView
                    android:id="@+id/avatarOpt2Editar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/baseline_account"
                    android:contentDescription="Avatar 2" />

                <!-- Avatar 3 -->
                <ImageView
                    android:id="@+id/avatarOpt3Editar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/logo_proxima_etapa"
                    android:contentDescription="Avatar 3" />
            </GridLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="#20000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome completo"
            android:textColor="@color/dark_indigo"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputNomeEditar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card_sobreposicao2"
            android:hint="Seu nome completo"
            android:inputType="textPersonName"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Idade"
            android:textColor="@color/dark_indigo"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputIdadeEditar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card_sobreposicao2"
            android:hint="Ex: 17 anos"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Sobre mim"
            android:textColor="@color/dark_indigo"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputBioEditar"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card_sobreposicao2"
            android:gravity="top|start"
            android:hint="Escreva algo sobre você..."
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Preferências de estudo e carreira"
            android:textColor="@color/dark_indigo"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputPreferenciasEditar"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card_sobreposicao2"
            android:gravity="top|start"
            android:hint="Ex: Tecnologia, Engenharia, FUVEST / USP..."
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textSize="13sp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelarEditarPerfil"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/transparent"
                android:text="Cancelar"
                android:textColor="@color/light_purple"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSalvarEditarPerfil"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/light_purple"
                android:text="Salvar alterações"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>