<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_sobreposicao2"
    android:elevation="8dp"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtTituloScannerProf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Leitura e Scanner de QR Code"
            android:textColor="@color/dark_indigo"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Aproxime a câmera do celular no QR Code do aluno ou digite o token individual para registrar presença:"
            android:textColor="@color/dark_gray"
            android:textSize="12sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="220dp"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/mint">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card_sobreposicao1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📸"
                    android:textSize="42sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Leitor de QR Code Ativo"
                    android:textColor="@color/mint"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Token / Código do Aluno:"
            android:textColor="@color/purple"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputTokenScanner"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card_sobreposicao2"
            android:hint="Cole ou digite o token do QR Code aqui..."
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="12sp" />


        <Button
            android:id="@+id/btnValidarToken"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/light_purple"
            android:text="Registrar Presença"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFecharScanner"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/white"
            android:text="Fechar Leitor"
            android:textColor="@color/light_purple"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>