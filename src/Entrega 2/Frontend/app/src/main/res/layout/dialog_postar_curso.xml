<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_sobreposicao2"
    android:elevation="6dp"
    android:padding="26dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🎓 Postar Curso"
            android:textColor="@color/dark_indigo"
            android:textSize="18sp"
            android:textStyle="bold" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="90dp"
                android:layout_height="70dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/yellow">

                <ImageView
                    android:id="@+id/imgPostarCurso"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/proximaetapa1"
                    android:contentDescription="Capa do Curso" />
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btnSelecionarCapaCursoProf"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:backgroundTint="@color/light_purple"
                android:text="📷 Escolher Capa"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputNomeCurso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nome do Curso"
                android:inputType="textCapWords"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputFaculdadeCurso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Faculdade"
                android:inputType="textCapWords"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputPontosTotaisCurso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Meta Total de Pontos (ex. 100 pontos para 100%)"
                android:inputType="number"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputPrazoReservaCurso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Período de Reserva (ex. Até 15/05/2026)"
                android:inputType="text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputPrazoTerminoCurso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Prazo de Término do Curso (ex. Até 30/11/2026)"
                android:inputType="text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Quantidade de Aulas:"
            android:textColor="@color/purple"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerQtdAulasCurso"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card_sobreposicao2"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Categoria do Curso (para Filtros):"
            android:textColor="@color/purple"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerTagCurso"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card_sobreposicao2"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputDiasSemanaCurso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Dias de Aula (ex. Seg, Qua e Sex - 14h às 16h)"
                android:inputType="text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Módulos:"
                android:textColor="@color/dark_yellow"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAdicionarModuloProf"
                android:layout_width="50dp"
                android:layout_height="36dp"
                android:backgroundTint="@color/transparent_yellow"
                android:paddingStart="10dp"
                android:paddingTop="0dp"
                android:paddingEnd="10dp"
                android:paddingBottom="0dp"
                android:text="➕"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/containerModulosProf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnPublicarCursoProfFinal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/mint"
            android:text="📢 Publicar Curso"
            android:textColor="@color/dark_indigo"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>