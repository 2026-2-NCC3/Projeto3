<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="180dp"
    android:background="@color/white2"
    tools:context=".aluno.AlunoCursosFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_header"
            android:elevation="2dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:src="@drawable/logo_proxima_etapa"/>

            <FrameLayout
                android:id="@+id/btnSininhoNotificacoes"
                android:layout_width="34dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconNotifications"
                    android:layout_width="34dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="12dp"
                    app:srcCompat="@drawable/icon_round_notifications"
                    app:tint="@color/yellow"
                    android:contentDescription="Off" />

                <ImageView
                    android:id="@+id/iconNotificationsActive"
                    android:layout_width="34dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="12dp"
                    app:srcCompat="@drawable/icon_round_notifications_active"
                    app:tint="@color/yellow"
                    android:contentDescription="On"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/badgeSininhoQtd"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_pill_red"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <View
                android:layout_width="38dp"
                android:layout_height="3dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="4dp"
                android:paddingTop="10dp"
                android:background="@drawable/bg_pill_tranppurple" />
        </FrameLayout>


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="0dp"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPagerCursosCarousel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/layoutDotsCursos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:background="#50000000"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/pontoImg1"
                        android:layout_width="20dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_dot_active" />

                    <View
                        android:id="@+id/pontoImg2"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_dot_inactive" />

                    <View
                        android:id="@+id/pontoImg3"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_dot_inactive" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_green"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:text="Faculades Relacionadas"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnAdicionarFaculdadeAdmin"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/yellow"
                android:paddingStart="10dp"
                android:paddingTop="0dp"
                android:paddingEnd="10dp"
                android:paddingBottom="0dp"
                android:text="➕ Faculdade"
                android:textColor="@color/dark_indigo"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Lista de Faculdades em Círculos com Foto e Nome Embaixo -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/contFacul"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Barra de Filtros Backdrop Pattern -->
        <LinearLayout
            android:id="@+id/btnToggleBackdropFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_card_sobreposicao1"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtFiltroSelecionadoBackdrop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔍 Filtrar Cursos: [ Todas as Áreas ] ▾"
                android:textColor="@color/dark_indigo"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="25dp"
                android:scaleType="centerCrop"
                android:src="@drawable/icon_round_filter_list" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_purple"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:text="Principais Cursos"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/contCursosPublicados"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

    </LinearLayout>
</ScrollView>