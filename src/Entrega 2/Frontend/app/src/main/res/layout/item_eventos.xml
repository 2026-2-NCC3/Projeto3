<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/grayish_red"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgEncontro"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            app:srcCompat="@drawable/logo_proxima_etapa"
            android:scaleType="centerCrop"
            android:contentDescription="Img Curso" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtTituloEvento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome Evento"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/grayish_indigo" />

            <TextView
                android:id="@+id/txtData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="xx/xx/xxxx - xxh"
                android:textAppearance="?attr/textAppearanceBody2"
                android:textColor="@color/red" />

            <TextView
                android:id="@+id/txtDescricaoEncontro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="descrição2"
                android:textAppearance="?attr/textAppearanceBody2"
                android:textColor="@color/grayish" />

            <TextView
                android:id="@+id/txtStatusAviso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:text="Disponível"
                android:textColor="#10B981"
                android:textStyle="bold"
                android:textSize="14sp"/>

        </LinearLayout>


    </LinearLayout>

</com.google.android.material.card.MaterialCardView>