<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_sobreposicao1"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtTituloNotif"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Inscrição Confirmada"
            android:textColor="@color/purple"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtHoraNotif"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14:30"
            android:textColor="@color/dark_gray"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtMensagemNotif"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Sua inscrição no curso de Administração &amp; Gestão foi realizada com sucesso!"
        android:textColor="@color/dark_indigo"
        android:textSize="12sp" />
</LinearLayout>