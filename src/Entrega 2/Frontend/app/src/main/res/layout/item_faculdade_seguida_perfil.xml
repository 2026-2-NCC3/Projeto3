<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@drawable/bg_card_sobreposicao2"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtNomeFaculdadeSeguidaPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Faculdade"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/dark_indigo"/>

        <TextView
            android:id="@+id/txtDescFaculdadeSeguidaPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descrição"
            android:textSize="12sp"
            android:textColor="@color/dark_gray"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnVerPerfilFaculdadeItem"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Ver Perfil"
        android:textSize="11sp"
        android:textColor="@color/dark_indigo"
        android:backgroundTint="@color/yellow"/>
</LinearLayout>